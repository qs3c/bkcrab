{
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "bkcrab",
    "operations"
  ],
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "bkcrab"
      ],
      "title": "Bkcrab 监控面板",
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "实例",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "bkcrab-prometheus"
        },
        "query": "label_values(up{job=\"bkcrab\"}, instance)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "uid": "bkcrab-agent",
  "title": "Bkcrab · 模型与工具",
  "description": "模型统计实际请求，重试单独计数；工具按固定名称归类，外部动态名称归入 other。",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "操作速率",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "bkcrab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (component, operation, mode) (rate(bkcrab_operations_total{job=\"bkcrab\",instance=~\"$instance\",component=~\"llm|tool\"}[$__rate_interval]))",
          "legendFormat": "{{component}} {{operation}} {{mode}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "操作异常与取消",
      "description": "error/timeout 与主动 canceled 分开。",
      "datasource": {
        "type": "prometheus",
        "uid": "bkcrab-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (component, operation, outcome) (rate(bkcrab_operations_total{job=\"bkcrab\",instance=~\"$instance\",component=~\"llm|tool\",outcome!=\"ok\"}[$__rate_interval]))",
          "legendFormat": "{{component}} {{operation}} {{outcome}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "模型完整调用 P95",
      "description": "stream 包含直到响应流结束的完整时长；buffered 也可能通过 SSE 获取完整响应。",
      "datasource": {
        "type": "prometheus",
        "uid": "bkcrab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, operation, mode) (rate(bkcrab_operation_duration_seconds_bucket{job=\"bkcrab\",instance=~\"$instance\",component=\"llm\"}[$__rate_interval])))",
          "legendFormat": "{{operation}} {{mode}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "模型首文本延迟 P95",
      "description": "首个非空文本 delta，不是首字节或 reasoning token；仅有工具/思考的响应无该样本。",
      "datasource": {
        "type": "prometheus",
        "uid": "bkcrab-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, protocol) (rate(bkcrab_llm_first_text_seconds_bucket{job=\"bkcrab\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{protocol}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "模型与工具在途操作",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "bkcrab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (component, operation, mode) (bkcrab_operations_inflight{job=\"bkcrab\",instance=~\"$instance\",component=~\"llm|tool\"})",
          "legendFormat": "{{component}} {{operation}} {{mode}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "工具执行 P95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "bkcrab-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(bkcrab_operation_duration_seconds_bucket{job=\"bkcrab\",instance=~\"$instance\",component=\"tool\"}[$__rate_interval])))",
          "legendFormat": "{{operation}}",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Token 消耗速率",
      "description": "仅上游实际报告值；缓存字段按协议语义单列，不盲目相加。",
      "datasource": {
        "type": "prometheus",
        "uid": "bkcrab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (protocol, kind) (rate(bkcrab_llm_tokens_total{job=\"bkcrab\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{protocol}} {{kind}}",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "区间 Token 用量",
      "description": "Prometheus increase 是插值估计，账单/配额应使用原有 usage 记录。",
      "datasource": {
        "type": "prometheus",
        "uid": "bkcrab-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (protocol, kind) (increase(bkcrab_llm_tokens_total{job=\"bkcrab\",instance=~\"$instance\"}[$__range]))",
          "legendFormat": "{{protocol}} {{kind}}",
          "range": true
        }
      ]
    }
  ],
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "15s",
      "30s",
      "1m",
      "5m"
    ]
  }
}
