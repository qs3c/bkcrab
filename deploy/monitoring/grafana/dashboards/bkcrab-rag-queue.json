    {
      "id": 5,
      "type": "timeseries",
      "title": "RAG 缓存命中比例",
      "description": "解析/视觉/增强缓存，不是 Agent context Redis 缓存。",
      "datasource": {
        "type": "prometheus",
        "uid": "bkcrab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
