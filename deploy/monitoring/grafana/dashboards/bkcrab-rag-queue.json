      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (operation) (rate(bkcrab_telemetry_events_total{job=\"bkcrab\",instance=~\"$instance\",signal=\"rag.result_cache\",outcome=\"hit\"}[$__rate_interval])) or 0 * sum by (operation) (rate(bkcrab_telemetry_events_total{job=\"bkcrab\",instance=~\"$instance\",signal=\"rag.result_cache\"}[$__rate_interval]))) / sum by (operation) (rate(bkcrab_telemetry_events_total{job=\"bkcrab\",instance=~\"$instance\",signal=\"rag.result_cache\"}[$__rate_interval]))",
          "legendFormat": "{{operation}}",
          "range": true
        }
      ]
    },
