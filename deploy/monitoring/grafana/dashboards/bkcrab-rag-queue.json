{
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "bkcrab",
    "operations"
  ],
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "bkcrab"
      ],
      "title": "Bkcrab 监控面板",
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "实例",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "bkcrab-prometheus"
        },
        "query": "label_values(up{job=\"bkcrab\"}, instance)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "uid": "bkcrab-rag-queue",
  "title": "Bkcrab · RAG 与公平队列",
  "description": "队列只展示启用的资源。共享状态按 max 聚合；检查采样年龄，陈旧数据不视为实时。",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "RAG 检索与索引速率",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "bkcrab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation, outcome) (rate(bkcrab_operations_total{job=\"bkcrab\",instance=~\"$instance\",component=\"rag\"}[$__rate_interval]))",
          "legendFormat": "{{operation}} {{outcome}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "RAG 检索与索引 P95",
      "description": "",
