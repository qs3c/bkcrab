          "refId": "A",
          "expr": "max by (resource, signal) (bkcrab_fairqueue_sample{job=\"bkcrab\",instance=~\"$instance\",signal=~\"rabbit.ready_depth|redis.inflight\"} and on (job, instance, resource, signal, kind) (time() - bkcrab_fairqueue_sample_timestamp_seconds{job=\"bkcrab\",instance=~\"$instance\"} < 120))",
          "legendFormat": "{{resource}} {{signal}}",
          "range": true
