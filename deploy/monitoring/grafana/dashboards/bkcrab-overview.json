{
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "bkcrab",
    "operations"
  ],
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "bkcrab"
      ],
      "title": "Bkcrab 监控面板",
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "实例",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "bkcrab-prometheus"
        },
        "query": "label_values(up{job=\"bkcrab\"}, instance)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "uid": "bkcrab-overview",
  "title": "Bkcrab · 服务与 Go 运行状态",
  "description": "先看实例与请求，再看业务操作面板。无数据表示未采集或尚无事件，并非健康。",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "实例采集状态",
      "description": "1：采集成功；0：采集失败。",
      "datasource": {
        "type": "prometheus",
        "uid": "bkcrab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"bkcrab\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP 请求速率",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "bkcrab-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance, mode) (rate(bkcrab_http_requests_total{job=\"bkcrab\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} {{mode}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP 状态码速率",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "bkcrab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(bkcrab_http_requests_total{job=\"bkcrab\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP 5xx 比例",
      "description": "排除静态文件和健康检查，避免探针稀释业务错误；无请求时不填充为 0。",
      "datasource": {
        "type": "prometheus",
        "uid": "bkcrab-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(bkcrab_http_requests_total{job=\"bkcrab\",route!~\"static|GET /healthz|GET /livez|GET /readyz\",instance=~\"$instance\",status=~\"5..\"}[$__rate_interval])) or 0 * sum(rate(bkcrab_http_requests_total{job=\"bkcrab\",route!~\"static|GET /healthz|GET /livez|GET /readyz\",instance=~\"$instance\"}[$__rate_interval]))) / sum(rate(bkcrab_http_requests_total{job=\"bkcrab\",route!~\"static|GET /healthz|GET /livez|GET /readyz\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "5xx",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "普通接口 P95",
      "description": "排除聊天、流、升级连接及探针。",
      "datasource": {
        "type": "prometheus",
        "uid": "bkcrab-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(bkcrab_http_request_duration_seconds_bucket{job=\"bkcrab\",instance=~\"$instance\",mode=\"request\",route!~\"static|GET /healthz|GET /livez|GET /readyz\"}[$__rate_interval])))",
          "legendFormat": "{{route}}",
          "range": true
        }
      ]
    },
