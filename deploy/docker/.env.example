MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
# Fairqueue dependencies. Generate unique production values. RabbitMQ password
# must be URL-safe because it is embedded in an AMQP URL (for example, use
# `openssl rand -hex 24`). Never use guest/guest outside localhost.
REDIS_PASSWORD=replace-with-a-long-random-redis-password
RABBITMQ_PASSWORD=replace-with-a-url-safe-random-rabbitmq-password
RABBITMQ_MANAGEMENT_PORT=15672
# Roll out legacy -> paused -> fair as separate full deployments. Keep false
# in legacy/paused; set true only for the final fair deployment.
FAIR_QUEUE_ENABLED=false
RAG_INDEX_WORKER_MODE=legacy
# Imagegen promotion is two separate complete rollouts: legacy -> drain, prove
# every legacy ReplicaSet/container is gone, then drain -> fair.
IMAGEGEN_BATCH_MODE=legacy
IMAGEGEN_MAX_IMAGES_PER_BATCH=16
IMAGEGEN_MAX_IMAGES_PER_TASK=4
IMAGEGEN_GLOBAL_CONCURRENCY=4
IMAGEGEN_PER_USER_BASE_CONCURRENCY=2
IMAGEGEN_PER_USER_BURST_CONCURRENCY=4
IMAGEGEN_TASK_LEASE=180s
IMAGEGEN_TASK_HEARTBEAT=30s
IMAGEGEN_RESERVATION_TTL=180s
IMAGEGEN_RESERVATION_HEARTBEAT=30s
IMAGEGEN_PROVIDER_CALL_TIMEOUT=120s
IMAGEGEN_ARTIFACT_DOWNLOAD_TIMEOUT=60s
IMAGEGEN_PROVIDER_CONCURRENCY_DEFAULT=4
MINIO_ROOT_USER=bkcrab
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
MINIO_BUCKET=bkcrab
MINIO_PREFIX=
BKCRAB_PORT=18953
BKCRAB_SANDBOX_IMAGE=qs3c/bkcrab-sandbox:latest
BKCRAB_MCP_GATEWAY_IMAGE=ghcr.io/lucky-aeon/mcp-gateway:latest
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
TZ=Asia/Shanghai

# Optional RAG overlay (docker-compose.rag.yml).
# The endpoint is an OpenAI-compatible base URL; BkCrab appends /embeddings.
RAG_EMBEDDING_ENDPOINT=https://example.com/v1
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-model
RAG_EMBEDDING_DIMS=1024

# Optional llama.cpp/Jina-compatible reranker. When using
# docker-compose.models.yml, use http://qwen3-reranker:8080/v1.
RAG_RERANKER_ENABLED=false
RAG_RERANKER_ENDPOINT=http://qwen3-reranker:8080/v1
RAG_RERANKER_API_KEY=
RAG_RERANKER_MODEL=qwen3-reranker
RAG_RERANKER_TIMEOUT_MS=5000
RAG_RERANKER_CANDIDATE_TOP_K=20
RAG_RERANKER_MIN_SCORE=0.5

# Sandboxed document parser sidecar. Keep the image pinned to an immutable
# release tag (or digest) in production; never use latest/dev.
RAG_PARSER_IMAGE=bkcrab/rag-parser:0.1.0
RAG_PARSER_SERVICE_VERSION=0.1.0
RAG_PARSER_CPUS=1.0
RAG_PARSER_MEMORY_LIMIT=1g
RAG_PARSER_TMPFS_SIZE_BYTES=536870912
# Both parser containers run concurrently. These two values select the active
# Office converter and must be changed together. For anydoc use
# http://rag-parser-anydoc:8080 and anydoc.
RAG_PARSER_ENDPOINT=http://rag-parser:8080
RAG_PARSER_ENGINE=markitdown
RAG_PARSER_ANYDOC_IMAGE=bkcrab/rag-parser-anydoc:0.1.0
RAG_PARSER_ANYDOC_SERVICE_VERSION=0.1.0-anydoc
RAG_PARSER_ANYDOC_CPUS=1.0
RAG_PARSER_ANYDOC_MEMORY_LIMIT=1g

# Parser and main-service limits. The parser receives these same canonical
# values and derives maxInputBytes and timeout seconds at startup. There are no
# independently configurable byte/second aliases to drift.
RAG_MAX_FILE_MB=50
RAG_MAX_PAGES_PER_DOCUMENT=300
RAG_MAX_ASSETS_PER_DOCUMENT=500
RAG_MAX_ASSET_BYTES=20971520
RAG_MAX_EXTRACTED_BYTES=209715200
RAG_MAX_IMAGE_PIXELS=40000000
RAG_PDF_RENDER_DPI=180
RAG_PARSE_TIMEOUT_MS=600000

# Advanced parsing, Office parsing and text enrichment are independent release
# gates and remain off by default. Enable only after the documented rollout
# checks have passed.
RAG_ADVANCED_ENABLED=false
RAG_OFFICE_ENABLED=false
RAG_ENRICHMENT_ENABLED=false

# Ingestion-only DocumentAI endpoint. The key is injected into bkcrab only and
# is never exposed to rag-parser. HTTPS is the safe default; private/HTTP
# endpoints require the explicit policy switch and an exact host allow-list.
RAG_DOCUMENT_AI_API_TYPE=openai-compatible
RAG_DOCUMENT_AI_ENDPOINT=
RAG_DOCUMENT_AI_API_KEY=
RAG_DOCUMENT_AI_VISION_MODEL=
RAG_DOCUMENT_AI_TEXT_MODEL=
# Use json_object for providers such as Xiaomi MiMo that guarantee JSON mode
# but do not enforce OpenAI's json_schema response format.
RAG_DOCUMENT_AI_RESPONSE_FORMAT=json_schema
RAG_DOCUMENT_AI_VISION_PROMPT_VERSION=vision-v3
RAG_DOCUMENT_AI_ALLOWED_ENDPOINT_HOSTS=
RAG_DOCUMENT_AI_ALLOW_PRIVATE_ENDPOINT=false

# Optional super-admin-only RAG evaluation plane. Disabled by default. Start
# the sidecar with: docker compose --profile rag-evaluation ... up -d.
# The evaluator receives questions, answers and retrieved contexts; configure
# only an approved private or external judge endpoint for your data boundary.
# The default evaluator network has no direct Internet route. Attach an
# approved private provider to rag-evaluator-internal, or route external
# providers through a separately reviewed allow-list egress proxy.
RAG_EVAL_ENABLED=false
RAG_EVALUATOR_IMAGE=bkcrab/rag-evaluator:0.1.0
RAG_EVALUATOR_SERVICE_VERSION=0.1.0
RAG_EVALUATOR_API_KEY=replace-with-a-long-random-token
RAG_EVALUATOR_LLM_PROVIDER=openai-compatible
RAG_EVALUATOR_LLM_ENDPOINT=
RAG_EVALUATOR_LLM_API_KEY=
RAG_EVALUATOR_LLM_MODEL=
RAG_EVALUATOR_EMBEDDING_PROVIDER=openai-compatible
RAG_EVALUATOR_EMBEDDING_ENDPOINT=
RAG_EVALUATOR_EMBEDDING_API_KEY=
RAG_EVALUATOR_EMBEDDING_MODEL=
# Required when RAG_EVAL_ENABLED=true and RAG_EVAL_MAX_RUN_COST_USD is non-zero.
RAG_EVAL_ANSWER_INPUT_COST_USD_PER_MILLION=0
RAG_EVAL_ANSWER_OUTPUT_COST_USD_PER_MILLION=0
RAG_EVALUATOR_LLM_INPUT_COST_USD_PER_MILLION=0
RAG_EVALUATOR_LLM_OUTPUT_COST_USD_PER_MILLION=0
RAG_EVALUATOR_EMBEDDING_COST_USD_PER_MILLION=0
RAG_EVAL_TIMEOUT_MS=120000
RAG_EVAL_WORKER_CONCURRENCY=1
RAG_EVAL_MAX_BATCH_SIZE=16
RAG_EVAL_MAX_CONTEXTS_PER_SAMPLE=20
RAG_EVAL_MAX_CONTEXT_BYTES=65536
RAG_EVAL_MAX_REQUEST_BYTES=4194304
RAG_EVALUATOR_MAX_TOTAL_CONTEXT_BYTES=1048576
RAG_EVALUATOR_MAX_REASON_CHARS=2048
RAG_EVALUATOR_METRIC_TIMEOUT_SECONDS=120
RAG_EVALUATOR_IDEMPOTENCY_CACHE_ENTRIES=1000
RAG_EVAL_MAX_RUN_CASES=1000
RAG_EVAL_MAX_RUN_TOKENS=2000000
RAG_EVAL_MAX_RUN_COST_USD=25
RAG_EVAL_MAX_RUN_DURATION_SEC=21600
RAG_EVAL_RUN_RETENTION_DAYS=90
RAG_EVAL_DATASET_RETENTION_DAYS=365
RAG_EVAL_GENERATION_RETENTION_DAYS=30
RAG_EVALUATOR_CPUS=1.0
RAG_EVALUATOR_MEMORY_LIMIT=1g
RAG_EVALUATOR_TMPFS_SIZE_BYTES=268435456

# Leave both empty unless Milvus authorization is enabled.
MILVUS_USERNAME=
MILVUS_PASSWORD=

# The optional overlay binds these ports to this host address. Keep 127.0.0.1
# unless a trusted LAN client (such as Attu) needs access. For this server, use
# 192.168.1.72 rather than 0.0.0.0 to avoid exposing Milvus on every interface.
MILVUS_BIND_ADDRESS=127.0.0.1
MILVUS_PORT=19530
MILVUS_WEB_PORT=19091
